# =============================================================================
# Recepcionista IA — variáveis de ambiente (copie para .env e preencha)
# NUNCA versione o arquivo .env. Gere senhas com:  openssl rand -base64 32
# Tokens de WhatsApp, OpenAI e Google NÃO ficam aqui: são cadastrados nas
# credenciais criptografadas do n8n (ver INSTALACAO.md).
# =============================================================================

# Domínio público do n8n (DNS apontando para o servidor). Ex.: recepcionista.suaempresa.com.br
N8N_DOMAIN=recepcionista.exemplo.com.br
# E-mail para o certificado HTTPS (Let's Encrypt)
ACME_EMAIL=ti@exemplo.com.br
# IPs/redes que podem abrir o EDITOR do n8n (separados por espaço). Webhooks continuam públicos.
# Ex.: "200.100.50.25/32 2804:abcd::/32". Use "0.0.0.0/0 ::/0" apenas temporariamente.
ADMIN_ALLOWED_IPS=127.0.0.1/32

# Chave de criptografia das credenciais do n8n (32+ caracteres). GUARDE EM LOCAL SEGURO:
# sem ela, as credenciais salvas não podem ser recuperadas.
N8N_ENCRYPTION_KEY=

# PostgreSQL — superusuário (somente administração e backup)
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=

# Banco interno do n8n
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

# Banco da Recepcionista IA (dados administrativos das clínicas)
RIA_DB_NAME=recepcionista
RIA_DB_USER=ria_app
RIA_DB_PASSWORD=

# Retenção de execuções do n8n (horas) — execuções com erro podem conter mensagens
N8N_EXECUTIONS_MAX_AGE_HOURS=72
N8N_LOG_LEVEL=warn

# Backups diários (pg_dump) em ./backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=2
